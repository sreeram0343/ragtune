# ==============================================================================
# RAGTUNE Enterprise Knowledge Intelligence Platform - Environment Configuration
# Copy this file to .env and configure environment-specific values.
# ==============================================================================

# Core Application Settings
APP_NAME="RAGTUNE Enterprise Knowledge Intelligence Platform"
VERSION="1.0.0"
DEBUG=false
SECRET_KEY="ragtune-secret-key-change-in-production-2026"
HOST="0.0.0.0"
PORT=8000
CORS_ORIGINS="*"

# Structured Storage & Database Settings
DATABASE_URL="sqlite:///./demo_data/enterprise_db.sqlite"
SQL_READ_ONLY=true
SQL_ROW_LIMIT=100
SQL_EXECUTION_TIMEOUT=10

# Vector Storage & Hybrid Retrieval
EMBEDDING_DIM=384
TOP_K_DENSE=10
TOP_K_SPARSE=10
TOP_K_RERANK=5
RRF_K=60.0

# 9-Layer Guardrails Pipeline Thresholds
ENFORCE_GUARDRAILS=true
MAX_INPUT_LENGTH=2000
GROUNDEDNESS_THRESHOLD=0.65
PII_MASK_CHAR="*"

# Caching Layer Settings
REDIS_URL="redis://localhost:6379/0"
ENABLE_CACHE=true
CACHE_TTL_SECONDS=3600
SEMANTIC_CACHE_THRESHOLD=0.92

# Human-in-the-Loop (HITL) Policy Settings
HITL_CONFIDENCE_THRESHOLD=0.75
AUTO_FLAG_MUTATIONS=true

# Security & Role-Based Access Control
DEFAULT_TENANT_ID="tenant_enterprise_default"
DEFAULT_USER_ROLE="ANALYST"
